# nRF24L01 (mirf) pin configuration - see external/esp-idf-mirf Kconfig.projbuild
CONFIG_RADIO_CHANNEL=90
CONFIG_MISO_GPIO=19
CONFIG_SCLK_GPIO=18
CONFIG_MOSI_GPIO=23
CONFIG_CE_GPIO=17
CONFIG_CSN_GPIO=5
CONFIG_SPI2_HOST=y

# Audio leci w paczkach po 15 probek, czyli ~533 pakiety/s (co 1.9 ms).
# Przy domyslnych 100 Hz najkrotszy vTaskDelay(1) to az 10 ms i odbiornik
# nie nadazal opróznic 3-elementowego FIFO radia.
CONFIG_FREERTOS_HZ=1000
